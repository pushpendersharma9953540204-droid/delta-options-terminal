# Delta Exchange API Configuration
# Paste your read-only API key and secret here if you want to fetch account balance and margins.
# Note: Public market data (live option chain, ATM straddle, strikes) does NOT require any API key!

# Choose: https://api.india.delta.exchange (India) or https://api.delta.exchange (Global)
DELTA_BASE_URL=https://api.india.delta.exchange

# Optional read-only credentials
DELTA_API_KEY=
DELTA_API_SECRET=
